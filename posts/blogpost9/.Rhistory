library("petersenlab")
library("future")
library("lavaan")
library("missRanger")
library("powerjoin")
library("tidymodels")
library("LongituRF")
library("gpboost")
library("effectsize")
library("tidyverse")
library("knitr")
load(file = "../../data/player_stats_weekly.RData")
load(file = "../../data/players_projections_weekly.RData")
load(file = "../../data/nfl_playerIDs.RData")
load(file = "../../data/nfl_actualStats_team.RData")
load(file = "../../data/projectionsWithActuals_weekly.RData")
nfl_actualStats_team_seasonal_reg$fumbles_lost <- rowSums(
nfl_actualStats_team_seasonal_reg[,c(
"sack_fumbles_lost",
"rushing_fumbles_lost",
"receiving_fumbles_lost")]
)
options(scipen = 999) # prevent scientific notation
faVars <- c(
"passing_yards","passing_tds","passing_interceptions","passing_epa","passing_cpoe",
"rushing_yards","rushing_tds","rushing_epa",
"receiving_epa","fumbles_lost"
)
petersenlab::cor.table(
nfl_actualStats_team_seasonal_reg[,faVars]
)
GGally::ggcorr(
nfl_actualStats_team_seasonal_reg[,faVars],
label = TRUE,
label_round = 2
)
psych::fa.parallel(
x = nfl_actualStats_team_seasonal_reg[faVars],
fm = "ml",
fa = "fa"
)
screeDataEFA <- nFactors::nScree(
x = cor(
nfl_actualStats_team_seasonal_reg[faVars],
use = "pairwise.complete.obs"),
model = "factors"
)
nFactors::plotnScree(screeDataEFA)
psych::vss(
nfl_actualStats_team_seasonal_reg[faVars],
rotate = "oblimin",
fm = "mle"
)
psych::nfactors(
nfl_actualStats_team_seasonal_reg[faVars],
rotate = "oblimin",
fm = "mle"
)
efa1factor_syntax <- '
# EFA Factor Loadings
efa("efa1")*f1 =~ passing_yards + passing_tds + passing_interceptions + passing_epa + passing_cpoe +
rushing_yards + rushing_tds + rushing_epa + receiving_epa + fumbles_lost
'
efa1factor_fit <- sem(
efa1factor_syntax,
data = nfl_actualStats_team_seasonal_reg,
information = "observed",
missing = "ML",
estimator = "MLR",
rotation = "geomin",
bounds = "standard",
meanstructure = TRUE,
em.h1.iter.max = 2000000
)
summary(
efa1factor_fit,
fit.measures = TRUE,
standardized = TRUE,
rsquare = TRUE
)
lavaanPlot::lavaanPlot(
efa1factor_fit,
coefs = TRUE,
covs = TRUE,
stand = TRUE
)
efa1factor_factorScores <- lavaan::lavPredict(efa1factor_fit)
nfl_actualStats_team_seasonal_reg <- cbind(
nfl_actualStats_team_seasonal_reg,
efa1factor_factorScores
)
nfl_actualStats_team_seasonal_reg %>%
arrange(-f1) %>%
select(season, team, f1, all_of(faVars)) %>%
na.omit() %>%
head()
nfl_actualStats_team_seasonal_reg %>%
arrange(f1) %>%
select(season, team, f1, all_of(faVars)) %>%
na.omit() %>%
head()
sessionInfo()
