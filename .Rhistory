library("petersenlab")
library("xts")
library("zoo")
library("forecast")
library("brms")
library("rstan")
library("plotly")
library("tidyverse")
library("SimDesign")
library("fitdistrplus")
library("sn")
load(file = "../../data/player_stats_weekly.RData")
load(file = "../../data/players_projections_weekly.RData")
load(file = "../../data/player_stats_seasonal.RData")
load(file = "../../data/players_projectedPoints_seasonal.RData")
load(file = "../../data/nfl_playerIDs.RData")
options(scipen = 999) # prevent scientific notation
target_season <- max(player_stats_weekly$season, na.rm = TRUE)
player_stats_weekly %>%
filter(
position == "QB",
season >= 2015,
season <= 2024,
!is.na(player_display_name)
) %>%
distinct(player_display_name) %>%
arrange(player_display_name) %>%
print(n = Inf)
early_late_by_player <- player_stats_weekly %>%
filter(
season == target_season,
!is.na(fantasyPoints),
week >= 1, week <= 17
) %>%
group_by(player_id, player_display_name, position, team) %>%
summarise(
mean_1_8  = mean(fantasyPoints[week %in% 1:8],  na.rm = TRUE),
games_1_8 = sum(week %in% 1:8  & !is.na(fantasyPoints)),
mean_9_17  = mean(fantasyPoints[week %in% 9:17], na.rm = TRUE),
games_9_17 = sum(week %in% 9:17 & !is.na(fantasyPoints)),
.groups = "drop"
) %>%
filter(games_1_8 > 0, games_9_17 > 0) %>%
mutate(
diff = mean_9_17 - mean_1_8,
direction = dplyr::case_when(
diff > 0  ~ "improved",
diff < 0  ~ "declined",
TRUE      ~ "no_change"
)
)
early_late_by_player %>%
filter(position == "QB") %>%
arrange(desc(diff))
early_late_by_player %>%
filter(position == "QB") %>%
arrange(diff)
early_late_by_player %>%
arrange(desc(diff)) %>%
head(195)
early_late_by_player %>%
arrange(diff) %>%
head(195)
arly_late_qb_2024 %>%
summarise(
avg_games_1_8  = mean(games_1_8),
avg_games_9_17 = mean(games_9_17),
mean_pts_1_8   = mean(mean_1_8),
mean_pts_9_17  = mean(mean_9_17)
)
