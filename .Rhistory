#install.packages("remotes")
#remotes::install_github("DevPsyLab/petersenlab")
#remotes::install_github("FantasyFootballAnalytics/ffanalytics")
#| message: false
#| warning: false
library("petersenlab")
library("future")
library("lavaan")
library("missRanger")
library("powerjoin")
library("tidymodels")
library("LongituRF")
library("gpboost")
library("effectsize")
library("tidyverse")
library("knitr")
load(file = "../../data/player_stats_weekly.RData")
load(file = "../../data/players_projections_weekly.RData")
load(file = "../../data/nfl_playerIDs.RData")
load(file = "../../data/nfl_actualStats_team.RData")
load(file = "../../data/projectionsWithActuals_weekly.RData")
load(file = "../../data/player_stats_seasonal.RData")
options(scipen = 999) # prevent scientific notation
qbs_from_2015_2024 <- player_stats_weekly %>%
filter(
position == "QB",
season >= 2015,
season <= 2024
) %>%
select(
player_id,
player_display_name,
season,
completions,
attempts,
passing_yards,
passing_tds,
passing_interceptions,
fantasyPoints
)
joshAllen_2024 <- player_stats_seasonal %>%
filter(
player_display_name == "Josh Allen",
position == "QB",
season == 2024
)
qb_season <- player_stats_seasonal %>%
filter(
position == "QB",
season >= 2015,
season <= 2024
)
qb_week <- player_stats_weekly %>%
filter(
position == "QB",
season >= 2015,
season <= 2024
)
# Previous-week vs next-week fantasy points for all QBs
qb_week_prev_next <- qb_week %>%
select(player_id, season, week, fantasyPoints) %>%
rename(
prev_week = week,
prev_fantasyPoints = fantasyPoints
) %>%
mutate(week = prev_week + 1) %>%
left_join(
qb_week %>%
select(player_id, season, week, fantasyPoints),
by = c("player_id", "season", "week")
) %>%
rename(next_fantasyPoints = fantasyPoints) %>%
filter(!is.na(next_fantasyPoints))
# Regression model: next-week points ~ previous-week points
qb_week_model <- lm(
next_fantasyPoints ~ prev_fantasyPoints,
data = qb_week_prev_next
)
# Josh Allen weekly data for 2024
joshAllen_weekly_2024 <- player_stats_weekly %>%
filter(
player_display_name == "Josh Allen",
position == "QB",
season == 2024
) %>%
arrange(week)
# Use each week’s points to predict the *next* week (weeks 2+)
ja_prev_for_pred <- joshAllen_weekly_2024 %>%
select(week, fantasyPoints) %>%
rename(
prev_week = week,
prev_fantasyPoints = fantasyPoints
) %>%
mutate(week = prev_week + 1) %>%
inner_join(                     # keep only weeks that actually exist
joshAllen_weekly_2024 %>% select(week),
by = "week"
)
# Predictions for each week (fit + 95% prediction interval)
ja_week_pred_mat <- predict(
qb_week_model,
newdata = data.frame(
prev_fantasyPoints = ja_prev_for_pred$prev_fantasyPoints
),
interval = "prediction",
level = 0.95
)
ja_week_preds <- cbind(ja_prev_for_pred, ja_week_pred_mat)
ja_week_preds
