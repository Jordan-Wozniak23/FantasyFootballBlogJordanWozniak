rename(next_fantasyPoints = fantasyPoints) %>%
filter(!is.na(next_fantasyPoints))
qb_nextSeason_model <- lm(
next_fantasyPoints ~ prev_fantasyPoints,
data = qb_prev_next
)
joshAllen_2024 <- player_stats_seasonal %>%
filter(
player_display_name == "Josh Allen",
position == "QB",
season == 2024
)
joshAllen_2025_pred <- predict(
qb_nextSeason_model,
newdata = data.frame(
prev_fantasyPoints = joshAllen_2024$fantasyPoints
),
interval = "prediction",
level = 0.95
)
joshAllen_2025_pred
