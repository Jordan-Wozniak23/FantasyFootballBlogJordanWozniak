library("petersenlab")
library("xts")
library("zoo")
library("forecast")
library("brms")
library("rstan")
library("plotly")
library("tidyverse")
library("SimDesign")
library("fitdistrplus")
library("sn")
load(file = "../../data/player_stats_weekly.RData")
load(file = "../../data/players_projections_weekly.RData")
load(file = "../../data/player_stats_seasonal.RData")
load(file = "../../data/players_projectedPoints_seasonal.RData")
load(file = "../../data/nfl_playerIDs.RData")
options(scipen = 999) # prevent scientific notation
target_season <- max(player_stats_weekly$season, na.rm = TRUE)
player_stats_weekly %>%
filter(
position == "QB",
season >= 2015,
season <= 2024,
!is.na(player_display_name)
) %>%
distinct(player_display_name) %>%
arrange(player_display_name) %>%
print(n = Inf)
early_late_by_player <- player_stats_weekly %>%
filter(
season == target_season,
!is.na(fantasyPoints),
week >= 1, week <= 17
) %>%
group_by(player_id, player_display_name, position, team) %>%
summarise(
mean_1_8  = mean(fantasyPoints[week %in% 1:8],  na.rm = TRUE),
games_1_8 = sum(week %in% 1:8  & !is.na(fantasyPoints)),
mean_9_17  = mean(fantasyPoints[week %in% 9:17], na.rm = TRUE),
games_9_17 = sum(week %in% 9:17 & !is.na(fantasyPoints)),
.groups = "drop"
) %>%
filter(games_1_8 > 0, games_9_17 > 0) %>%
mutate(
diff = mean_9_17 - mean_1_8,
direction = dplyr::case_when(
diff > 0  ~ "improved",
diff < 0  ~ "declined",
TRUE      ~ "no_change"
)
)
early_late_by_player %>%
filter(position == "QB") %>%
arrange(desc(diff))
early_late_by_player %>%
filter(position == "QB") %>%
arrange(diff)
early_late_by_player %>%
arrange(desc(diff)) %>%
head(195)
early_late_by_player %>%
arrange(diff) %>%
head(195)
qb_2015_2024 <- player_stats_weekly %>%
filter(
season >= 2015,
season <= 2024,
position == "QB",
!is.na(fantasyPoints)
)
## Early season averages: Weeks 1–8
qb_early <- qb_2015_2024 %>%
filter(week >= 1, week <= 8) %>%
group_by(player_id, player_display_name, team, season) %>%
summarise(
games_1_8 = dplyr::n(),
mean_1_8  = mean(fantasyPoints, na.rm = TRUE)
) %>%
ungroup()
## Late season averages: Weeks 9–17
qb_late <- qb_2015_2024 %>%
filter(week >= 9, week <= 17) %>%
group_by(player_id, player_display_name, team, season) %>%
summarise(
games_9_17 = dplyr::n(),
mean_9_17  = mean(fantasyPoints, na.rm = TRUE)
) %>%
ungroup()
## Combine early + late and compute change
early_late_qb <- qb_early %>%
left_join(
qb_late,
by = c("player_id", "player_display_name", "team", "season")
) %>%
mutate(
diff = mean_9_17 - mean_1_8,
direction = if_else(diff > 0, "improved", "declined")
)
early_late_qb
early_late_qb <- player_stats_weekly %>%
filter(
position == "QB",
season >= 2015, season <= 2024,
!is.na(fantasyPoints),
week >= 1, week <= 17
) %>%
group_by(season, player_id, player_display_name, team) %>%
summarise(
mean_1_8   = mean(fantasyPoints[week %in% 1:8],  na.rm = TRUE),
games_1_8  = sum(week %in% 1:8  & !is.na(fantasyPoints)),
mean_9_17  = mean(fantasyPoints[week %in% 9:17], na.rm = TRUE),
games_9_17 = sum(week %in% 9:17 & !is.na(fantasyPoints)),
.groups = "drop"
) %>%
filter(games_1_8 > 0, games_9_17 > 0) %>%
mutate(diff = mean_9_17 - mean_1_8)
ggplot(
data = early_late_qb,
mapping = aes(x = mean_1_8, y = mean_9_17)
) +
geom_point(alpha = 0.5) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
labs(
x = "Average Fantasy Points (Weeks 1–8)",
y = "Average Fantasy Points (Weeks 9–17)",
title = "QB Fantasy Performance: Early vs Late Season",
subtitle = "Seasons 2015–2024; points above the line improved later in the year"
) +
theme_classic()
early_late_all %>%
filter(season >= 2015, season <= 2024) %>%
summarise(
n_players       = n(),
avg_games_1_8   = mean(games_1_8,  na.rm = TRUE),
avg_games_9_17  = mean(games_9_17, na.rm = TRUE),
avg_mean_1_8    = mean(mean_1_8,   na.rm = TRUE),
avg_mean_9_17   = mean(mean_9_17,  na.rm = TRUE)
)
early_late_qb %>%  # or early_late
summarise(
n_players      = n(),
avg_games_1_8  = mean(games_1_8,  na.rm = TRUE),
avg_games_9_17 = mean(games_9_17, na.rm = TRUE),
avg_mean_1_8   = mean(mean_1_8,   na.rm = TRUE),
avg_mean_9_17  = mean(mean_9_17,  na.rm = TRUE)
)
